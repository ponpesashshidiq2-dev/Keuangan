# Aplikasi Keuangan Pondok Pesantren — konfigurasi Apache shared hosting
AddDefaultCharset UTF-8

# Sembunyikan file sensitif
<FilesMatch "^(db\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Folder data tidak boleh diakses langsung
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>

DirectoryIndex index.html
